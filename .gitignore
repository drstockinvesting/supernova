# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# iCloud Drive placeholder files
*.icloud

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Editors
.vscode/
.idea/
*.swp

# Node / Vite
node_modules/
app/dist/
*.tsbuildinfo

# The dataset is committed once, at data/. app/public/data is a symlink to it so
# the dev server can serve it; committing the link would duplicate 178MB.
app/public/data

# Local scratch — not part of the dataset
scratch/
*.local.json

# Agent worktrees — real git worktrees checked out inside the repo. Committing
# them would commit a second copy of the tree, including the dataset.
# `.claude/launch.json` is deliberately not ignored; settings.local.json is
# already covered by *.local.json above.
.claude/worktrees/
